{
  "functions": {
    "api/coletar.js": {
      "maxDuration": 60
    },
    "api/enriquecer.js": {
      "maxDuration": 60
    },
    "api/coletar-ticketsports.js": {
      "maxDuration": 60
    },
    "api/coletar-minhasinscricoes.js": {
      "maxDuration": 60
    },
    "api/extrair.js": {
      "maxDuration": 30
    },
    "api/corrida.js": {
      "maxDuration": 10,
      "includeFiles": "index.html"
    },
    "api/sitemap.js": {
      "maxDuration": 20
    },
    "api/avisos.js": {
      "maxDuration": 60
    },
    "api/corridas.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/enriquecer?modo=reprocessar",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/coletar?grupo=1",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/coletar?grupo=2",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/coletar-ticketsports",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/coletar-minhasinscricoes",
      "schedule": "20 15 * * *"
    },
    {
      "path": "/api/enriquecer",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/enriquecer?r=2",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/enriquecer?r=3",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/enriquecer?r=4",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/enriquecer?r=5",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/enriquecer?r=6",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/coletar?grupo=1&r=2",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/coletar?grupo=2&r=2",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/enriquecer?so=pinos",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/avisos?acao=enviar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/enriquecer?modo=textos",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/enriquecer?modo=textos&r=2",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/enriquecer?modo=textos&r=3",
      "schedule": "30 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src * data: blob:; connect-src 'self' https://ssfsxdmzbubvygctdjgf.supabase.co wss://ssfsxdmzbubvygctdjgf.supabase.co https://api.open-meteo.com https://archive-api.open-meteo.com https://nominatim.openstreetmap.org https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/corrida/:slug",
      "destination": "/api/corrida?slug=:slug"
    },
    {
      "source": "/corridas",
      "destination": "/api/corridas"
    },
    {
      "source": "/corridas/:uf",
      "destination": "/api/corridas?uf=:uf"
    },
    {
      "source": "/corridas/:uf/:cidade",
      "destination": "/api/corridas?uf=:uf&cidade=:cidade"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/*": false
    }
  }
}
